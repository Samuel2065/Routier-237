# URL de l'API Laravel (backend/routier-api)
VITE_API_URL=http://localhost:8000

# Temps réel (Laravel Reverb). Laisser VITE_REVERB_APP_KEY vide pour désactiver le temps réel :
# l'application se rabat alors sur une interrogation régulière de l'API.
# La clé est publique (identique à REVERB_APP_KEY du backend) ; le secret reste côté serveur.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Notifications push (Firebase Cloud Messaging) : configuration web PUBLIQUE de l'application
# Firebase (console Firebase → Paramètres du projet → Vos applications) et clé VAPID publique
# (onglet Cloud Messaging → Certificats Web Push). Laisser vide pour désactiver le push.
# Ne jamais mettre ici le fichier du compte de service (clé privée) : il reste côté serveur.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
