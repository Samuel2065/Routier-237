# Modèle uniquement. Le vrai fichier est ~/domains/routier237.artischools.com/app/shared/.env
# sur le serveur (chmod 600). Ne jamais y mettre de valeur réelle ici ni le committer.
# Étapes : deploy/README.md. Une clé par ligne (en cas de doublon, la dernière l'emporte).
# Premier déploiement : partir de l'ancien .env (même APP_KEY), voir le README.
APP_NAME="Routier+237"
APP_ENV=production          # staging pendant la phase de test (paiement simulé autorisé)
APP_KEY=                    # reprise de l'ancien .env ; jamais régénérée en production
APP_DEBUG=false
APP_URL=https://api.routier237.artischools.com
FRONTEND_URL=https://routier237.artischools.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=daily
LOG_LEVEL=notice

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                # hPanel > Bases de données
DB_USERNAME=
DB_PASSWORD=                # entre apostrophes s'il contient # $ " ou des espaces

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync       # aucun processus permanent sur l'hébergement mutualisé
FILESYSTEM_DISK=local
SANCTUM_TOKEN_EXPIRATION=10080

# Hébergement mutualisé : pas de Reverb (processus permanent) → actualisation par interrogation.
BROADCAST_CONNECTION=null

MAIL_MAILER=log             # resend + RESEND_KEY quand l'envoi d'e-mails sera activé

PAYMENT_DEFAULT_DRIVER=mock # simulation (refusée en production) tant que les identifiants manquent
PAYMENT_MOCK_WEBHOOK_SECRET=

# Notifications push : fichier du compte de service dans shared/storage/app/private/.
FCM_ENABLED=false
# FIREBASE_CREDENTIALS : ne pas définir (vide = chemin invalide) ; défaut storage/app/private/firebase-credentials.json
